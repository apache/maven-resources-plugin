<project>
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.apache.maven.plugins.resources.its</groupId>
  <artifactId>MRESOURCES-graceful-binary</artifactId>
  <version>1.0</version>
  <packaging>jar</packaging>

  <description>Integration test for gracefulBinaryHandling: when a binary file is included in a
    filtered resource directory and gracefulBinaryHandling=true, the build should succeed
    and the binary file should be copied as-is (byte-for-byte identical to the source).</description>

  <build>
    <resources>
      <resource>
        <!-- filtering=true on the whole resource dir; the .p12 would normally cause
             a MalformedInputException. gracefulBinaryHandling silences it and copies as-is. -->
        <filtering>true</filtering>
        <directory>src/main/resources</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>@project.version@</version>
        <configuration>
          <gracefulBinaryHandling>true</gracefulBinaryHandling>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
